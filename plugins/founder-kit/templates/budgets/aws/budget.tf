# Budget as code for {{PROJECT}}: monthly cost budget + automatic deny policy at 100%.
# Generated by `fk budget plan aws {{USD}}`. The founder reviews and runs `terraform apply`; the kit never applies it.
# Test once in simulation: set approval_model = "MANUAL" first, check the action appears as pending at the threshold, then switch to "AUTOMATIC".

variable "alert_email" {
  type    = string
  default = "REPLACE_WITH_ALERT_EMAIL"
}

variable "restricted_role_names" {
  description = "IAM roles the deny policy is attached to (the roles your app and agents deploy with)."
  type        = list(string)
  default     = ["REPLACE_WITH_DEPLOY_ROLE"]
}

resource "aws_budgets_budget" "monthly" {
  name         = "{{PROJECT}}-monthly"
  budget_type  = "COST"
  limit_amount = "{{USD}}"
  limit_unit   = "USD"
  time_unit    = "MONTHLY"

  notification {
    comparison_operator        = "GREATER_THAN"
    threshold                  = 80
    threshold_type             = "PERCENTAGE"
    notification_type          = "ACTUAL"
    subscriber_email_addresses = [var.alert_email]
  }

  notification {
    comparison_operator        = "GREATER_THAN"
    threshold                  = 100
    threshold_type             = "PERCENTAGE"
    notification_type          = "FORECASTED"
    subscriber_email_addresses = [var.alert_email]
  }
}

resource "aws_iam_policy" "fk_deny_new_spend" {
  name   = "{{PROJECT}}-fk-deny-new-spend"
  policy = file("${path.module}/deny-policy.json")
}

data "aws_iam_policy_document" "budgets_assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["budgets.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "budgets_action" {
  name               = "{{PROJECT}}-fk-budget-action"
  assume_role_policy = data.aws_iam_policy_document.budgets_assume.json
}

resource "aws_iam_role_policy_attachment" "budgets_action" {
  role       = aws_iam_role.budgets_action.name
  policy_arn = "arn:aws:iam::aws:policy/AWSBudgetsActionsWithAWSResourceControlAccess"
}

resource "aws_budgets_budget_action" "deny_at_limit" {
  budget_name        = aws_budgets_budget.monthly.name
  action_type        = "APPLY_IAM_POLICY"
  approval_model     = "AUTOMATIC"
  notification_type  = "ACTUAL"
  execution_role_arn = aws_iam_role.budgets_action.arn

  action_threshold {
    action_threshold_type  = "PERCENTAGE"
    action_threshold_value = 100
  }

  definition {
    iam_action_definition {
      policy_arn = aws_iam_policy.fk_deny_new_spend.arn
      roles      = var.restricted_role_names
    }
  }

  subscriber {
    address           = var.alert_email
    subscription_type = "EMAIL"
  }
}
