# Budget as code for {{PROJECT}}: monthly budget -> Pub/Sub -> function that unlinks billing at 100%.
# Generated by `fk budget plan gcp {{USD}}`. The founder reviews and runs `terraform apply`; the kit never applies it.
# Unlinking billing stops every paid service in the project and can delete resources. DRY_RUN stays "true" until tested.

variable "project_id" {
  type    = string
  default = "REPLACE_WITH_PROJECT_ID"
}
variable "billing_account" {
  type    = string
  default = "REPLACE_WITH_BILLING_ACCOUNT_ID"
}
variable "region" {
  type    = string
  default = "us-central1"
}
variable "dry_run" {
  description = "true: the function only logs what it would do. Set false after one simulated test."
  type        = string
  default     = "true"
}

data "google_project" "this" {
  project_id = var.project_id
}

resource "google_pubsub_topic" "budget" {
  project = var.project_id
  name    = "{{PROJECT}}-fk-budget"
}

resource "google_billing_budget" "monthly" {
  billing_account = var.billing_account
  display_name    = "{{PROJECT}}-monthly"

  budget_filter {
    projects = ["projects/${data.google_project.this.number}"]
  }

  amount {
    specified_amount {
      currency_code = "USD"
      units         = "{{USD}}"
    }
  }

  threshold_rules { threshold_percent = 0.5 }
  threshold_rules { threshold_percent = 0.9 }
  threshold_rules { threshold_percent = 1.0 }

  all_updates_rule {
    pubsub_topic = google_pubsub_topic.budget.id
  }
}

resource "google_service_account" "killer" {
  project      = var.project_id
  account_id   = "fk-billing-kill"
  display_name = "fk billing kill switch"
}

# Needed to unlink billing from this project.
resource "google_project_iam_member" "killer_billing" {
  project = var.project_id
  role    = "roles/billing.projectManager"
  member  = "serviceAccount:${google_service_account.killer.email}"
}

resource "google_storage_bucket" "src" {
  project                     = var.project_id
  name                        = "${var.project_id}-fk-budget-src"
  location                    = var.region
  uniform_bucket_level_access = true
}

data "archive_file" "fn" {
  type        = "zip"
  source_dir  = "${path.module}/function"
  output_path = "${path.module}/.build/function.zip"
}

resource "google_storage_bucket_object" "fn" {
  name   = "function-${data.archive_file.fn.output_md5}.zip"
  bucket = google_storage_bucket.src.name
  source = data.archive_file.fn.output_path
}

resource "google_cloudfunctions2_function" "kill" {
  project  = var.project_id
  name     = "{{PROJECT}}-fk-billing-kill"
  location = var.region

  build_config {
    runtime     = "python312"
    entry_point = "stop_billing"
    source {
      storage_source {
        bucket = google_storage_bucket.src.name
        object = google_storage_bucket_object.fn.name
      }
    }
  }

  service_config {
    max_instance_count    = 1
    service_account_email = google_service_account.killer.email
    environment_variables = {
      GCP_PROJECT_ID = var.project_id
      DRY_RUN        = var.dry_run
    }
  }

  event_trigger {
    trigger_region = var.region
    event_type     = "google.cloud.pubsub.topic.v1.messagePublished"
    pubsub_topic   = google_pubsub_topic.budget.id
    retry_policy   = "RETRY_POLICY_RETRY"
  }
}
