# One command interface: the same short commands on every computer and in CI.
# A fresh clone runs with `just setup`, then `just check`. Tool versions come from .mise.toml (pin `just` there too,
# e.g. just = "1.58.0"), services from compose.yaml (Podman by default; Docker users set COMPOSE="docker compose").
# Replace each GATE-MISSING / example line with this project's real commands; keep the recipe names.
# Fallback messages are single-quoted so they print the same under PowerShell and sh.

# Newer just prefers `[windows]` on `set shell`, which just 1.15 (the kit's floor) does not know; this form works on both.
set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

compose := env("COMPOSE", "podman compose")

# List the recipes.
default:
    @just --list

# Install the pinned tools and the dependencies; safe to run again. Add the lockfile install, e.g. npm ci, uv sync --frozen.
setup:
    mise install

# Start the services, then the app in development mode (e.g. npm run dev).
dev: up
    echo 'dev: add the command that starts the app'

# Every gate the project has: lint, types, tests, the kit's boundary checker.
check:
    {{ if path_exists("scripts/fk-boundaries.mjs") == "true" { "node scripts/fk-boundaries.mjs" } else { "echo 'no boundary checker yet (fk gates build)'" } }}
    echo 'GATE-MISSING: lint, types and tests (replace these two lines)'
    exit 1

# Start the services in compose.yaml (databases, caches, queues), if any.
up:
    @{{ if path_exists("compose.yaml") == "true" { compose + " up -d" } else { "echo 'no compose.yaml: no services to start'" } }}

# Stop the services; data volumes stay.
down:
    @{{ if path_exists("compose.yaml") == "true" { compose + " down" } else { "echo 'no compose.yaml: nothing to stop'" } }}
