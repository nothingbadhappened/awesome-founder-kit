// Budget as code for {{PROJECT}}: monthly consumption budget with alerts at 80% actual and 100% forecast.
// Generated by `fk budget plan azure {{USD}}`. The founder reviews and deploys it; the kit never applies it.
// Deploy: az deployment sub create --location <region> --template-file budget.bicep --parameters alertEmail=<you> startDate=<YYYY-MM-01>
targetScope = 'subscription'

param alertEmail string
@description('First day of the current month, YYYY-MM-01.')
param startDate string
param actionGroupId string = ''

resource budget 'Microsoft.Consumption/budgets@2023-05-01' = {
  name: '{{PROJECT}}-monthly'
  properties: {
    category: 'Cost'
    amount: {{USD}}
    timeGrain: 'Monthly'
    timePeriod: {
      startDate: startDate
    }
    notifications: {
      actual80: {
        enabled: true
        operator: 'GreaterThan'
        threshold: 80
        thresholdType: 'Actual'
        contactEmails: [ alertEmail ]
        contactGroups: empty(actionGroupId) ? [] : [ actionGroupId ]
      }
      forecast100: {
        enabled: true
        operator: 'GreaterThan'
        threshold: 100
        thresholdType: 'Forecasted'
        contactEmails: [ alertEmail ]
        contactGroups: empty(actionGroupId) ? [] : [ actionGroupId ]
      }
    }
  }
}
